///|
/// A structured handoff separates automated evidence from professional review.
pub(all) enum HandoffPriority {
  HandoffRoutine
  HandoffSoon
  HandoffUrgent
  HandoffImmediate
} derive(Debug, Eq, ToJson)

///|
pub(all) enum HandoffDisposition {
  HandoffContinue
  HandoffHold
  HandoffReduce
  HandoffPause
  HandoffRefer
} derive(Debug, Eq, ToJson)

///|
pub(all) struct HandoffEvidence {
  source : String
  title : String
  value : Double
  threshold : Double
  direction : String
  explanation : String
} derive(Debug, Eq, ToJson)

///|
pub(all) struct ClinicalHandoff {
  handoff_id : String
  run_id : String
  athlete_label : String
  generated_for : String
  priority : HandoffPriority
  disposition : HandoffDisposition
  summary : String
  evidence : Array[HandoffEvidence]
  questions : Array[String]
  next_review_days : Int
  valid : Bool
} derive(Debug, Eq, ToJson)

///|
pub fn handoff_priority_name(priority : HandoffPriority) -> String {
  match priority {
    HandoffRoutine => "routine"
    HandoffSoon => "soon"
    HandoffUrgent => "urgent"
    HandoffImmediate => "immediate"
  }
}

///|
pub fn handoff_disposition_name(disposition : HandoffDisposition) -> String {
  match disposition {
    HandoffContinue => "continue"
    HandoffHold => "hold"
    HandoffReduce => "reduce"
    HandoffPause => "pause"
    HandoffRefer => "refer"
  }
}

///|
fn handoff_priority(run : DecisionRun) -> HandoffPriority {
  if run.status == "critical" {
    HandoffImmediate
  } else if decision_run_requires_action(run) {
    HandoffUrgent
  } else if run.status == "review" {
    HandoffSoon
  } else {
    HandoffRoutine
  }
}

///|
fn handoff_disposition(run : DecisionRun) -> HandoffDisposition {
  if run.status == "critical" {
    HandoffRefer
  } else if decision_run_requires_action(run) {
    HandoffReduce
  } else {
    HandoffContinue
  }
}

///|
fn handoff_evidence(run : DecisionRun) -> Array[HandoffEvidence] {
  let values = []
  values.push({
    source: "decision_run",
    title: "risk_score",
    value: decision_run_latest_risk(run),
    threshold: 40.0,
    direction: "higher_is_worse",
    explanation: "latest composite risk score",
  })
  values.push({
    source: "decision_run",
    title: "readiness_score",
    value: decision_run_latest_readiness(run),
    threshold: 65.0,
    direction: "lower_is_worse",
    explanation: "latest training readiness score",
  })
  values.push({
    source: "monitoring",
    title: "alert_count",
    value: decision_run_alert_count(run).to_double(),
    threshold: 1.0,
    direction: "higher_is_worse",
    explanation: "alerts generated by the daily monitor",
  })
  values.push({
    source: "events",
    title: "event_count",
    value: decision_run_event_count(run).to_double(),
    threshold: 1.0,
    direction: "higher_is_worse",
    explanation: "risk events in the run",
  })
  values.push({
    source: "quality",
    title: "quality_score",
    value: run.quality.report.score,
    threshold: 80.0,
    direction: "lower_is_worse",
    explanation: "input quality gate score",
  })
  values
}

///|
fn handoff_questions(run : DecisionRun) -> Array[String] {
  let questions = []
  if decision_run_latest_risk(run) >= 40.0 {
    questions.push("which signal is the primary driver of current risk?")
  }
  if decision_run_latest_readiness(run) < 65.0 {
    questions.push("has readiness recovered before the next planned load?")
  }
  if run.quality.report.blocking_issue_count > 0 {
    questions.push("can the input quality issue be repaired before use?")
  }
  if decision_run_event_count(run) > 0 {
    questions.push("has each risk event received a documented follow-up?")
  }
  questions
}

///|
fn handoff_run_summary(
  run : DecisionRun,
  disposition : HandoffDisposition,
) -> String {
  "status=" +
  run.status +
  " disposition=" +
  handoff_disposition_name(disposition) +
  " risk=" +
  decision_run_latest_risk(run).to_string() +
  " readiness=" +
  decision_run_latest_readiness(run).to_string() +
  " recommendation=" +
  decision_run_recommendation(run)
}

///|
pub fn build_clinical_handoff(
  run : DecisionRun,
  athlete_label : String,
) -> ClinicalHandoff {
  let priority = handoff_priority(run)
  let disposition = handoff_disposition(run)
  let base = {
    handoff_id: "handoff-" + run.config.run_id,
    run_id: run.config.run_id,
    athlete_label,
    generated_for: run.monitoring.generated_for,
    priority,
    disposition,
    summary: handoff_run_summary(run, disposition),
    evidence: handoff_evidence(run),
    questions: handoff_questions(run),
    next_review_days: if priority == HandoffImmediate {
      0
    } else if priority == HandoffUrgent {
      1
    } else if priority == HandoffSoon {
      3
    } else {
      7
    },
    valid: false,
  }
  {
    handoff_id: base.handoff_id,
    run_id: base.run_id,
    athlete_label: base.athlete_label,
    generated_for: base.generated_for,
    priority: base.priority,
    disposition: base.disposition,
    summary: base.summary,
    evidence: base.evidence,
    questions: base.questions,
    next_review_days: base.next_review_days,
    valid: handoff_fields_valid(base),
  }
}

///|
fn handoff_fields_valid(handoff : ClinicalHandoff) -> Bool {
  handoff.handoff_id != "" &&
  handoff.run_id != "" &&
  handoff.athlete_label != "" &&
  handoff.generated_for != "" &&
  handoff.evidence.length() > 0 &&
  handoff.next_review_days >= 0
}

///|
pub fn handoff_valid(handoff : ClinicalHandoff) -> Bool {
  handoff.valid &&
  handoff_fields_valid(handoff) &&
  handoff.evidence.all(evidence => {
    evidence.source != "" && evidence.title != "" && evidence.explanation != ""
  })
}

///|
pub fn handoff_requires_immediate_review(handoff : ClinicalHandoff) -> Bool {
  handoff.priority == HandoffImmediate
}

///|
pub fn handoff_requires_review(handoff : ClinicalHandoff) -> Bool {
  handoff.priority != HandoffRoutine || handoff.questions.length() > 0
}

///|
pub fn handoff_is_safe_to_continue(handoff : ClinicalHandoff) -> Bool {
  handoff.disposition == HandoffContinue && handoff.priority == HandoffRoutine
}

///|
pub fn handoff_is_refer(handoff : ClinicalHandoff) -> Bool {
  handoff.disposition == HandoffRefer
}

///|
pub fn handoff_is_pause(handoff : ClinicalHandoff) -> Bool {
  handoff.disposition == HandoffPause
}

///|
pub fn handoff_is_reduce(handoff : ClinicalHandoff) -> Bool {
  handoff.disposition == HandoffReduce
}

///|
pub fn handoff_is_hold(handoff : ClinicalHandoff) -> Bool {
  handoff.disposition == HandoffHold
}

///|
pub fn handoff_priority_rank(priority : HandoffPriority) -> Int {
  match priority {
    HandoffRoutine => 0
    HandoffSoon => 1
    HandoffUrgent => 2
    HandoffImmediate => 3
  }
}

///|
pub fn handoff_disposition_rank(disposition : HandoffDisposition) -> Int {
  match disposition {
    HandoffContinue => 0
    HandoffHold => 1
    HandoffReduce => 2
    HandoffPause => 3
    HandoffRefer => 4
  }
}

///|
pub fn handoff_evidence_by_title(
  handoff : ClinicalHandoff,
  title : String,
) -> HandoffEvidence? {
  for evidence in handoff.evidence {
    if evidence.title == title {
      return Some(evidence)
    }
  }
  None
}

///|
pub fn handoff_evidence_titles(handoff : ClinicalHandoff) -> Array[String] {
  handoff.evidence.map(evidence => evidence.title)
}

///|
pub fn handoff_evidence_values(handoff : ClinicalHandoff) -> Array[Double] {
  handoff.evidence.map(evidence => evidence.value)
}

///|
pub fn handoff_evidence_count(handoff : ClinicalHandoff) -> Int {
  handoff.evidence.length()
}

///|
pub fn handoff_question_count(handoff : ClinicalHandoff) -> Int {
  handoff.questions.length()
}

///|
pub fn handoff_evidence_above(
  handoff : ClinicalHandoff,
  threshold : Double,
) -> Array[HandoffEvidence] {
  handoff.evidence.filter(evidence => evidence.value >= threshold)
}

///|
pub fn handoff_evidence_below(
  handoff : ClinicalHandoff,
  threshold : Double,
) -> Array[HandoffEvidence] {
  handoff.evidence.filter(evidence => evidence.value < threshold)
}

///|
pub fn handoff_evidence_names_above(
  handoff : ClinicalHandoff,
  threshold : Double,
) -> Array[String] {
  handoff_evidence_above(handoff, threshold).map(evidence => evidence.title)
}

///|
pub fn handoff_risk_evidence(handoff : ClinicalHandoff) -> HandoffEvidence? {
  handoff_evidence_by_title(handoff, "risk_score")
}

///|
pub fn handoff_readiness_evidence(
  handoff : ClinicalHandoff,
) -> HandoffEvidence? {
  handoff_evidence_by_title(handoff, "readiness_score")
}

///|
pub fn handoff_quality_evidence(handoff : ClinicalHandoff) -> HandoffEvidence? {
  handoff_evidence_by_title(handoff, "quality_score")
}

///|
pub fn handoff_alert_evidence(handoff : ClinicalHandoff) -> HandoffEvidence? {
  handoff_evidence_by_title(handoff, "alert_count")
}

///|
pub fn handoff_latest_risk(handoff : ClinicalHandoff) -> Double {
  match handoff_risk_evidence(handoff) {
    Some(evidence) => evidence.value
    None => 0.0
  }
}

///|
pub fn handoff_latest_readiness(handoff : ClinicalHandoff) -> Double {
  match handoff_readiness_evidence(handoff) {
    Some(evidence) => evidence.value
    None => 0.0
  }
}

///|
pub fn handoff_quality(handoff : ClinicalHandoff) -> Double {
  match handoff_quality_evidence(handoff) {
    Some(evidence) => evidence.value
    None => 0.0
  }
}

///|
pub fn handoff_alert_count(handoff : ClinicalHandoff) -> Int {
  match handoff_alert_evidence(handoff) {
    Some(evidence) => evidence.value.to_int()
    None => 0
  }
}

///|
pub fn handoff_checksum(handoff : ClinicalHandoff) -> String {
  let mut value = handoff.handoff_id.length() + handoff.evidence.length()
  for character in handoff_text(handoff) {
    value = (value * 31 + character.to_int()) % 2147483647
  }
  value.to_string()
}

///|
pub fn handoff_reproducible(
  left : ClinicalHandoff,
  right : ClinicalHandoff,
) -> Bool {
  handoff_checksum(left) == handoff_checksum(right)
}

///|
pub fn handoff_text(handoff : ClinicalHandoff) -> String {
  let builder = StringBuilder()
  builder.write_string(
    "id=" +
    handoff.handoff_id +
    " run=" +
    handoff.run_id +
    " athlete=" +
    handoff.athlete_label +
    " date=" +
    handoff.generated_for +
    " priority=" +
    handoff_priority_name(handoff.priority) +
    " disposition=" +
    handoff_disposition_name(handoff.disposition),
  )
  builder.write_string(
    "\nsummary=" +
    handoff.summary +
    "\nnext_review_days=" +
    handoff.next_review_days.to_string(),
  )
  for evidence in handoff.evidence {
    builder.write_string(
      "\nevidence=" +
      evidence.title +
      " value=" +
      evidence.value.to_string() +
      " threshold=" +
      evidence.threshold.to_string() +
      " explanation=" +
      evidence.explanation,
    )
  }
  for question in handoff.questions {
    builder.write_string("\nquestion=" + question)
  }
  builder.to_string()
}

///|
pub fn handoff_evidence_text(evidence : HandoffEvidence) -> String {
  evidence.source +
  ":" +
  evidence.title +
  " value=" +
  evidence.value.to_string() +
  " threshold=" +
  evidence.threshold.to_string() +
  " direction=" +
  evidence.direction +
  " explanation=" +
  evidence.explanation
}

///|
pub fn handoff_questions_text(handoff : ClinicalHandoff) -> String {
  handoff.questions.join("\n")
}

///|
pub fn handoff_csv_header() -> String {
  "source,title,value,threshold,direction,explanation"
}

///|
pub fn handoff_evidence_csv(evidence : HandoffEvidence) -> String {
  evidence.source +
  "," +
  evidence.title +
  "," +
  evidence.value.to_string() +
  "," +
  evidence.threshold.to_string() +
  "," +
  evidence.direction +
  "," +
  evidence.explanation
}

///|
pub fn handoff_csv(handoff : ClinicalHandoff) -> String {
  let builder = StringBuilder()
  builder.write_string(handoff_csv_header())
  for evidence in handoff.evidence {
    builder.write_string("\n" + handoff_evidence_csv(evidence))
  }
  builder.to_string()
}

///|
pub fn handoff_summary_header() -> Array[String] {
  [
    "handoff_id", "run_id", "athlete_label", "generated_for", "priority", "disposition",
    "next_review_days", "valid",
  ]
}

///|
pub fn handoff_summary(handoff : ClinicalHandoff) -> Array[String] {
  [
    handoff.handoff_id,
    handoff.run_id,
    handoff.athlete_label,
    handoff.generated_for,
    handoff_priority_name(handoff.priority),
    handoff_disposition_name(handoff.disposition),
    handoff.next_review_days.to_string(),
    handoff.valid.to_string(),
  ]
}

///|
pub fn handoff_summary_csv(handoff : ClinicalHandoff) -> String {
  handoff_summary_header().join(",") + "\n" + handoff_summary(handoff).join(",")
}

///|
pub fn handoff_status_code(handoff : ClinicalHandoff) -> Int {
  if !handoff.valid {
    422
  } else if handoff.priority == HandoffImmediate {
    409
  } else if handoff.priority == HandoffUrgent {
    206
  } else {
    200
  }
}

///|
pub fn handoff_recommendation(handoff : ClinicalHandoff) -> String {
  if handoff.disposition == HandoffRefer {
    "refer to qualified review"
  } else if handoff.disposition == HandoffPause {
    "pause progression"
  } else if handoff.disposition == HandoffReduce {
    "reduce the next exposure"
  } else if handoff.disposition == HandoffHold {
    "hold the current plan"
  } else {
    "continue with scheduled monitoring"
  }
}

///|
pub fn handoff_contract(handoff : ClinicalHandoff) -> Array[String] {
  [
    handoff_priority_name(handoff.priority),
    handoff_disposition_name(handoff.disposition),
    handoff_status_code(handoff).to_string(),
    handoff_recommendation(handoff),
    handoff_review_label(handoff),
    handoff_valid(handoff).to_string(),
    handoff_checksum(handoff),
  ]
}

///|
pub fn handoff_review_label(handoff : ClinicalHandoff) -> String {
  "review_in_" + handoff.next_review_days.to_string() + "_days"
}

///|
pub fn handoff_priority_label(handoff : ClinicalHandoff) -> String {
  handoff_priority_name(handoff.priority)
}

///|
pub fn handoff_disposition_label(handoff : ClinicalHandoff) -> String {
  handoff_disposition_name(handoff.disposition)
}

///|
pub fn handoff_question_categories(handoff : ClinicalHandoff) -> Array[String] {
  let values = []
  for question in handoff.questions {
    if question.has_prefix("which") {
      values.push("signal")
    } else if question.has_prefix("has readiness") {
      values.push("readiness")
    } else if question.has_prefix("can") {
      values.push("data")
    } else {
      values.push("follow_up")
    }
  }
  values
}

///|
pub fn handoff_has_question(handoff : ClinicalHandoff, text : String) -> Bool {
  handoff.questions.contains(text)
}

///|
pub fn handoff_has_evidence(handoff : ClinicalHandoff, title : String) -> Bool {
  handoff_evidence_by_title(handoff, title) is Some(_)
}

///|
pub fn handoff_evidence_average(handoff : ClinicalHandoff) -> Double {
  mean_load_values(handoff_evidence_values(handoff))
}

///|
pub fn handoff_evidence_maximum(handoff : ClinicalHandoff) -> Double {
  maximum_load_values(handoff_evidence_values(handoff))
}

///|
pub fn handoff_evidence_minimum(handoff : ClinicalHandoff) -> Double {
  minimum_load_values(handoff_evidence_values(handoff))
}

///|
pub fn handoff_evidence_deviation(handoff : ClinicalHandoff) -> Double {
  standard_deviation_values(handoff_evidence_values(handoff))
}

///|
pub fn handoff_source_names(handoff : ClinicalHandoff) -> Array[String] {
  let values = []
  for evidence in handoff.evidence {
    if !values.contains(evidence.source) {
      values.push(evidence.source)
    }
  }
  values
}

///|
pub fn handoff_source_count(handoff : ClinicalHandoff) -> Int {
  handoff_source_names(handoff).length()
}

///|
pub fn handoff_has_complete_evidence(handoff : ClinicalHandoff) -> Bool {
  handoff.evidence.length() >= 4
}

///|
pub fn handoff_data_quality(handoff : ClinicalHandoff) -> String {
  if !handoff_valid(handoff) {
    "invalid"
  } else if !handoff_has_complete_evidence(handoff) {
    "limited"
  } else {
    "usable"
  }
}

///|
pub fn handoff_exportable(handoff : ClinicalHandoff) -> Bool {
  handoff_valid(handoff)
}

///|
pub fn handoff_export_status(handoff : ClinicalHandoff) -> String {
  if handoff_exportable(handoff) {
    "exportable"
  } else {
    "blocked"
  }
}
